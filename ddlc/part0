            left: 0px;
            width: 100%;
            height: 100%;
            border: 0 none;
        }

        #canvas {
            background: #000;
        }

        .visible {
            visibility: visible;
            opacity: 1.0;
            transition: opacity .1s linear;
        }

        .hidden {
            visibility: hidden;
            opacity: 0;
            transition: visibility 0s .25s, opacity .25s linear;
        }

        #statusDiv,
        #inputDiv {
            background: rgba(0, 0, 0, 0.75);
